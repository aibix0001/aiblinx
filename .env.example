# Env for the aiblinx stack. Copy to `.env` (next to docker-compose.yml); Compose
# interpolates the values via ${VAR}. The minimum is one AI preset below (an
# OpenRouter key is enough); everything else is optional and can be added later.
# For a local `uv run` from app/, copy to app/.env and set DATA_DIR=./data.

DATA_DIR=/data

# discover-app image. Unset = the latest release. To stay on one version (and
# make rollback a one-line edit), pin a release tag:
#DISCOVER_APP_IMAGE=ghcr.io/aibix0001/aiblinx:0.1.0

# --- Optional parts (Compose profiles) ---------------------------------------
# Only discover-app is required. Add what you want, comma-separated:
#   miniflux  full RSS reader app (+Postgres); without it aiblinx reads feeds itself
#   searxng   fills the Exploring section (also set SEARXNG_URL and
#             SEARXNG_SECRET below)
#   ollama    local AI models (see preset C)
# e.g. COMPOSE_PROFILES=searxng
COMPOSE_PROFILES=

# --- AI model: pick ONE preset ----------------------------------------------
# Switching the embedding model later is fine: the app backs up its database
# and re-embeds everything over the next cycle (a few minutes of model calls).
#
# A) OpenRouter — recommended without your own GPU. One key, sign up with email
#    or GitHub (no phone number): https://openrouter.ai/keys
#    Embeddings are free; the chat model that ranks and explains costs about
#    5 cents a month. For a completely free setup add LLM_RERANK=false (no
#    re-rank, no "why" line). Free OpenRouter models may keep or train on the
#    text they are sent.
OPENROUTER_API_KEY=
#    Portable alternative embedder (same model as Ollama's bge-m3, ~cents):
# LLM_EMBED_MODEL=baai/bge-m3
# EMBED_DIM=1024
#
# B) NVIDIA NIM (hosted; signup needs phone verification)
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_TOKEN=nvapi-REPLACE_ME
# LLM_CHAT_MODEL=meta/llama-3.3-70b-instruct
# LLM_EMBED_MODEL=nvidia/nv-embedqa-e5-v5
# EMBED_DIM=1024
#
# C) Ollama — fully local (COMPOSE_PROFILES must include "ollama"). After the
#    first start pull the models once:
#      docker compose exec ollama ollama pull bge-m3
#      docker compose exec ollama ollama pull qwen3:4b   # optional chat model
# LLM_BASE_URL=http://ollama:11434/v1
# LLM_EMBED_MODEL=bge-m3
# EMBED_DIM=1024
# LLM_CHAT_MODEL=qwen3:4b
# LLM_RERANK=false        # set when you skip the chat model (CPU-only boxes)
#
# D) Any other OpenAI-compatible server (vLLM, llama.cpp, LocalAI, ...)
# LLM_BASE_URL=http://your-server:8000/v1
# LLM_TOKEN=
# LLM_CHAT_MODEL=
# LLM_EMBED_BASE_URL=     # if embeddings are served elsewhere
# LLM_EMBED_MODEL=
# EMBED_DIM=

# Linkwarden (optional) — your existing instance (Settings -> Access Tokens).
# Leave the token empty to keep saves in aiblinx itself; connect later and
# local saves are copied into Linkwarden on the next poll.
LINKWARDEN_BASE_URL=https://linkwarden.example.com
LINKWARDEN_TOKEN=
# Collection that "+" captures land in — find the id in the collection page URL
# or GET /api/v1/collections. ALWAYS an id, never a name ("Unorganized" is NOT
# always id 1 — check your instance).
LINKWARDEN_COLLECTION_ID=1
# Saves from the Exploring section go to their own collection and never shape
# "For you". Empty: a collection named "Exploring" is found or created.
LINKWARDEN_EXPLORE_COLLECTION_ID=

# Miniflux (profile "miniflux", UI on host port 8011) — optional full RSS
# reader. Without it aiblinx reads your sites' feeds itself. When you add the
# profile, uncomment these; the app creates its own API key from the admin
# login (set MINIFLUX_TOKEN only to use a key you created yourself).
# MF_DB_PASSWORD=REPLACE_ME
# MF_ADMIN_USER=admin
# MF_ADMIN_PASSWORD=REPLACE_ME
# MINIFLUX_TOKEN=
# Feed sync: each cycle finds the feeds of sites you keep (at least
# FEED_SYNC_MIN_LINKS pages from one site) and subscribes them, in Miniflux or
# the built-in reader, up to FEED_SYNC_PER_CYCLE new sites per cycle.
FEED_SYNC_MIN_LINKS=2
FEED_SYNC_PER_CYCLE=20

# Hacker News (public API, no auth)
HACKERNEWS_ENABLED=true
HACKERNEWS_LIST=beststories

# Public URL the Atom feed advertises for itself (set to your reverse-proxy URL)
PUBLIC_BASE_URL=http://localhost:8000
# Card links: "same" opens articles in the feed's tab (swipe back to the feed),
# "new" opens a new tab.
LINK_TARGET=same
# When set, POST /admin/run-cycle requires this value in the X-Admin-Token
# header (each call spends LLM credit). Empty = open, for local use only.
ADMIN_TOKEN=
# Optional login. Empty = open (fine at home / behind a VPN). Set it when the
# feed is reachable from the internet; every device then logs in once.
APP_PASSWORD=

# SearXNG (profile "searxng"): fills Exploring for the topics you pick. Empty =
# Exploring off. With the profile on: SEARXNG_URL=http://searxng:8080
SEARXNG_URL=
# Required by the searxng image: openssl rand -hex 32
SEARXNG_SECRET=
